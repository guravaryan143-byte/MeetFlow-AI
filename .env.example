# Backend Environment Variables (Never commit real secrets to .env)
ENVIRONMENT=development
# Local SQLite development
DATABASE_URL=sqlite:///./meetflow.db

# Docker/PostgreSQL mode
# DATABASE_URL=postgresql://meetflow:change-me@localhost:5432/meetflow
POSTGRES_PASSWORD=change-me
JWT_SECRET_KEY=dev-only-change-in-production-meetflow-secret-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# AI providers are opt-in. Default is credential-free deterministic demo mode.
AI_PROVIDER=deterministic
TRANSCRIPTION_PROVIDER=deterministic
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_API_KEY=
GEMINI_API_KEY=
WHISPER_API_KEY=

# External integration mode: mock (safe demo) or live (requires provider credentials).
INTEGRATION_MODE=mock
# Credentials are environment-only and accessed ONLY by AuthorizedExecutionService.
LINEAR_API_KEY=
LINEAR_TEAM_ID=
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000
